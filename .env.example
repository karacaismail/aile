# Apps Script web uygulamasının /exec adresi (gizli değil; uygulama Ayarlar'dan da değiştirilebilir)
VITE_API_URL=
# Bütçe e-tablosu kimliği (canlı GViz okuması). Derlemeye gömülür; gerçek değer yalnız .env.local'da ya da yayında
# repository variable olarak durur, Git'e yazılmaz. Testler ve kapılar sentetik kimlikle koşar.
VITE_BUDGET_SHEET_ID=
# Yönetim paneli kalıcı yerel saklama (IndexedDB: nesil parça önbelleği aile-admin/partitions ve canlı bütçenin son
# iyi okuması). Boş: geliştirmede açık, üretim derlemesinde KAPALI (yalnız sekme belleği; ortak Pages kökeni için
# fail-closed). idb | on: açık (üretimde yalnız bu açık istekle). off | memory ya da tanınmayan değer: kapalı.
VITE_AILE_PARTITION_CACHE=
# Yalnız dev sunucusu (vite serve) ara katmanı /__aile/generation/*: data-platform ile üretilmiş özel nesil kökü
# (generations/<sha256>/manifest.json taşıyan klasör veya onun üst klasörü). Git dışında tutulur; build'e girmez.
# Değer YALNIZ süreç ortamından okunur: ne Vite ne de ara katman bu anahtarı .env / .env.local dosyasından okur, bu
# yüzden düz `pnpm dev` gerçek nesli göremez. Tanımsızsa ara katman 404 "AILE_GENERATION_DIR tanımlı değil" döner;
# panel nesil göstermez ve klasör içe aktarmayı sunar. Ara katman yalnız manifest.json, data/** parçaları ve _meta'yı,
# yalnız aynı kökene servis eder.
# Sentetik önizleme (docs/ADMIN-RUNBOOK.md §3): AILE_GENERATION_DIR="$PWD/fixtures/generation-synthetic" ile başlatılır.
# Gerçek nesille yerel önizleme (docs/ADMIN-RUNBOOK.md §4, yalnız kullanıcının ana kopyasında, açık komutla):
#   env -u VITE_BUDGET_SHEET_ID -u AILE_GENERATION_DIR \
#     node --env-file=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port <P> --strictPort
AILE_GENERATION_DIR=
