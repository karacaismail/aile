# Apps Script web uygulamasının /exec adresi (gizli değil; uygulama Ayarlar'dan da değiştirilebilir)
VITE_API_URL=
# Yalnız dev sunucusu (vite serve): data-platform ile üretilmiş özel nesil kökü (generations/<sha256>/manifest.json taşıyan
# klasör veya onun üst klasörü). Git dışında tutulur; tanımsızsa panel sentetik nesli (fixtures/generation-synthetic) ya da
# klasör içe aktarmayı kullanır. Build'e girmez.
# Dikkat: Vite .env.local'dan yalnız VITE_ önekli anahtarları alır; düz `pnpm dev` bu değeri .env.local'dan OKUMAZ.
# Gerçek nesille yerel önizleme (docs/ADMIN-RUNBOOK.md §4, yalnız kullanıcının ana kopyasında):
#   env -u VITE_BUDGET_SHEET_ID -u AILE_GENERATION_DIR \
#     node --env-file=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port <P> --strictPort
# (d02-loading dev sunucusuna loadEnv desteği eklediğinde bu not güncellenir.)
AILE_GENERATION_DIR=
