{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aile:data-platform:manifest:v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generation_id",
    "tenant_id",
    "files",
    "counts",
    "sources",
    "storage_policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "storage_policy": {
      "const": "private_only"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "partition",
              "raw",
              "schema",
              "contract"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "collection": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "consistency": {
      "const": "snapshot_capture_not_transaction"
    }
  }
}
