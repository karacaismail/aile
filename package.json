{
  "name": "aile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Canlı aile bütçesi ve kurallı araç finansmanı simülasyonu",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "gas:build": "node scripts/build-gas.mjs",
    "gas:push": "pnpm gas:build && clasp push -f",
    "seed": "node scripts/seed.mjs",
    "e2e:dashboard": "playwright test --config playwright.dashboard.config.ts"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/form": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/modals": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@phosphor-icons/react": "2.1.10",
    "dayjs": "1.11.23",
    "echarts": "6.0.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@google/clasp": "3.4.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
